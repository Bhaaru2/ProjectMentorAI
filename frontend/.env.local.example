# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.

# Supabase project URL (same as SUPABASE_URL in backend/.env)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key — safe for browser use.
# Find it in: Supabase dashboard → Project Settings → API → "anon public"
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# FastAPI backend (default: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000
